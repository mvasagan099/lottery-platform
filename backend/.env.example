# ============================================================
# MEGADRAW LOTTERY PLATFORM — Backend Environment Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env with real values to version control.
# ============================================================

# --- Server ---
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# --- Redis ---
REDIS_URL=redis://:STRONG_PASSWORD@HOST:6379

# --- JWT Secrets (generate with: node -e "require('crypto').randomBytes(64).toString('hex') |> console.log") ---
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_HEX_SECRET

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@yourdomain.com

# --- Email (Resend) ---
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXX

# --- Frontend URL (used in emails) ---
FRONTEND_URL=https://yourdomain.com

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXX

# --- PayPal ---
PAYPAL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXX
PAYPAL_SECRET=XXXXXXXXXXXXXXXXXXXX
PAYPAL_WEBHOOK_ID=XXXXXXXXXXXXXXXXXXXX

# --- Coupon Platform Integration ---
COUPON_API_URL=https://your-coupon-api.onrender.com/api/v1
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COUPON_API_KEY=REPLACE_WITH_64_CHAR_HEX_KEY
