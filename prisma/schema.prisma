// Prisma Schema for OzLotto Platform
// Production-ready lottery platform database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ENUMS ============

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
}

enum KYCStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TICKET_PURCHASE
  PRIZE_CREDIT
  BONUS_CREDIT
  REFUND
  REFERRAL_BONUS
  AFFILIATE_COMMISSION
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

enum DrawStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  FAILED
}

enum TicketStatus {
  ACTIVE
  CHECKED
  WON
  LOST
  CANCELLED
  EXPIRED
}

enum PaymentGateway {
  STRIPE
  PAYPAL
  BANK_TRANSFER
  CRYPTO
}

enum NotificationType {
  EMAIL
  IN_APP
  PUSH
  SMS
}

enum SupportTicketStatus {
  OPEN
  PENDING
  WAITING_FOR_CUSTOMER
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  ESCALATED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
  AFFILIATE_MANAGER
  USER
}

// ============ MODELS ============

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  username         String     @unique
  passwordHash     String
  firstName        String
  lastName         String
  dateOfBirth      DateTime?
  phone            String?
  role             UserRole   @default(USER)
  status           UserStatus @default(PENDING_VERIFICATION)
  emailVerified    Boolean    @default(false)
  emailVerifiedAt  DateTime?
  twoFactorEnabled Boolean    @default(false)
  twoFactorSecret  String?
  referralCode     String     @unique @default(cuid())
  referredById     String?
  referredBy       User?      @relation("Referrals", fields: [referredById], references: [id])
  referrals        User[]     @relation("Referrals")
  kycStatus        KYCStatus  @default(NOT_SUBMITTED)
  country          String?
  state            String?
  city             String?
  address          String?
  postcode         String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  lastLoginAt      DateTime?
  lastLoginIp      String?

  wallet            Wallet?
  sessions          Session[]
  transactions      Transaction[]
  tickets           Ticket[]
  kycRecords        KYCRecord[]
  notifications     Notification[]
  supportTickets    SupportTicket[]
  affiliateAccount  AffiliateAccount?
  auditLogs         AuditLog[]
  devices           DeviceHistory[]
  notificationPrefs NotificationPreference?

  SupportAgent      SupportAgent?
  roles             UserRoleMapping[]

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  refreshToken String   @unique
  ipAddress    String?
  userAgent    String?
  deviceName   String?
  isActive     Boolean  @default(true)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())

  @@map("sessions")
}

model DeviceHistory {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName String
  ipAddress  String
  userAgent  String
  location   String?
  lastSeenAt DateTime @default(now())
  trusted    Boolean  @default(false)

  @@map("device_history")
}

model KYCRecord {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  documentType String
  documentUrl  String
  selfieUrl    String?
  status       KYCStatus @default(PENDING)
  reviewedById String?
  reviewNotes  String?
  submittedAt  DateTime  @default(now())
  reviewedAt   DateTime?

  @@map("kyc_records")
}

model Wallet {
  id             String        @id @default(cuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id])
  balance        Decimal       @default(0) @db.Decimal(18, 2)
  bonusBalance   Decimal       @default(0) @db.Decimal(18, 2)
  pendingBalance Decimal       @default(0) @db.Decimal(18, 2)
  currency       String        @default("USD")
  totalDeposited Decimal       @default(0) @db.Decimal(18, 2)
  totalWithdrawn Decimal       @default(0) @db.Decimal(18, 2)
  totalWon       Decimal       @default(0) @db.Decimal(18, 2)
  totalSpent     Decimal       @default(0) @db.Decimal(18, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  transactions   Transaction[]
  deposits       Deposit[]
  withdrawals    Withdrawal[]

  @@map("wallets")
}

model Transaction {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id])
  walletId      String
  wallet        Wallet            @relation(fields: [walletId], references: [id])
  type          TransactionType
  status        TransactionStatus @default(PENDING)
  amount        Decimal           @db.Decimal(18, 2)
  balanceBefore Decimal           @db.Decimal(18, 2)
  balanceAfter  Decimal           @db.Decimal(18, 2)
  currency      String            @default("USD")
  reference     String            @unique
  description   String?
  metadata      Json?
  ticketId      String?
  drawId        String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("transactions")
}

model Deposit {
  id          String            @id @default(cuid())
  walletId    String
  wallet      Wallet            @relation(fields: [walletId], references: [id])
  amount      Decimal           @db.Decimal(18, 2)
  currency    String            @default("USD")
  gateway     PaymentGateway
  gatewayRef  String?
  status      TransactionStatus @default(PENDING)
  metadata    Json?
  processedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("deposits")
}

model Withdrawal {
  id             String            @id @default(cuid())
  walletId       String
  wallet         Wallet            @relation(fields: [walletId], references: [id])
  amount         Decimal           @db.Decimal(18, 2)
  currency       String            @default("USD")
  gateway        PaymentGateway
  accountDetails Json
  status         TransactionStatus @default(PENDING)
  reviewedById   String?
  reviewNotes    String?
  processedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("withdrawals")
}

// H-4 FIX: Stripe webhook idempotency ledger.
// Keyed on Stripe's event.id. The INSERT inside the payment_intent.succeeded
// transaction will fail on the unique constraint if the event was already
// processed, preventing duplicate wallet credits under concurrent delivery.
model ProcessedWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique // Stripe event.id, e.g. "evt_1ABC..."
  source      String   @default("stripe") // "stripe" | "paypal" etc.
  processedAt DateTime @default(now())

  @@map("processed_webhook_events")
}

model Game {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String
  shortDescription String?
  rulesJson        Json
  drawSchedule     String // cron expression
  jackpotAmount    Decimal  @db.Decimal(18, 2)
  minJackpot       Decimal  @db.Decimal(18, 2)
  ticketPrice      Decimal  @db.Decimal(18, 2)
  minNumbers       Int
  maxNumbers       Int
  numberPool       Int
  hasSupplementary Boolean  @default(false)
  suppNumbers      Int?
  suppPool         Int?
  hasPowerball     Boolean  @default(false)
  powerballPool    Int?
  isActive         Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  sortOrder        Int      @default(0)
  imageUrl         String?
  bannerUrl        String?
  badgeText        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  draws          Draw[]
  tickets        Ticket[]
  prizeDivisions PrizeDivision[]
  jackpotPool    JackpotPool?

  @@map("games")
}

model PrizeDivision {
  id            String   @id @default(cuid())
  gameId        String
  game          Game     @relation(fields: [gameId], references: [id])
  divisionName  String
  divisionOrder Int
  description   String
  fixedPrize    Decimal? @db.Decimal(18, 2)
  isJackpot     Boolean  @default(false)
  matchNumbers  Int
  matchSupp     Int      @default(0)
  matchPB       Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@map("prize_divisions")
}

model Draw {
  id             String     @id @default(cuid())
  gameId         String
  game           Game       @relation(fields: [gameId], references: [id])
  drawNumber     Int
  scheduledAt    DateTime
  drawnAt        DateTime?
  status         DrawStatus @default(SCHEDULED)
  jackpotAmount  Decimal    @db.Decimal(18, 2)
  totalSales     Decimal    @default(0) @db.Decimal(18, 2)
  totalPrizes    Decimal    @default(0) @db.Decimal(18, 2)
  winningNumbers Json?
  supplementary  Json?
  powerball      Int?
  isVerified     Boolean    @default(false)
  verifiedById   String?
  publishedAt    DateTime?
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tickets        Ticket[]
  winningEntries WinningEntry[]

  @@map("draws")
}

model Ticket {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  gameId        String
  game          Game         @relation(fields: [gameId], references: [id])
  drawId        String?
  draw          Draw?        @relation(fields: [drawId], references: [id])
  ticketNumber  String       @unique
  qrCode        String?
  status        TicketStatus @default(ACTIVE)
  isQuickPick   Boolean      @default(false)
  isSystemEntry Boolean      @default(false)
  isSyndicate   Boolean      @default(false)
  syndicateId   String?
  draws         Int          @default(1)
  totalCost     Decimal      @db.Decimal(18, 2)
  prizeAmount   Decimal?     @db.Decimal(18, 2)
  prizeDivision String?
  claimedAt     DateTime?
  purchasedAt   DateTime     @default(now())
  validUntil    DateTime?
  metadata      Json?

  numbers        TicketNumber[]
  winningEntries WinningEntry[]

  @@map("tickets")
}

model TicketNumber {
  id            String @id @default(cuid())
  ticketId      String
  ticket        Ticket @relation(fields: [ticketId], references: [id])
  lineIndex     Int
  numbers       Json // array of selected numbers
  supplementary Json? // supplementary numbers if applicable
  powerball     Int?

  @@map("ticket_numbers")
}

model WinningEntry {
  id           String    @id @default(cuid())
  ticketId     String
  ticket       Ticket    @relation(fields: [ticketId], references: [id])
  drawId       String
  draw         Draw      @relation(fields: [drawId], references: [id])
  divisionName String
  prizeAmount  Decimal   @db.Decimal(18, 2)
  isPaid       Boolean   @default(false)
  paidAt       DateTime?
  createdAt    DateTime  @default(now())

  @@map("winning_entries")
}

model Syndicate {
  id          String   @id @default(cuid())
  gameId      String
  name        String
  description String?
  shares      Int
  sharePrice  Decimal  @db.Decimal(18, 2)
  totalCost   Decimal  @db.Decimal(18, 2)
  drawId      String?
  maxMembers  Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("syndicates")
}

model Bonus {
  id          String    @id @default(cuid())
  name        String
  description String
  type        String // WELCOME, DEPOSIT, REFERRAL, PROMOTIONAL
  amount      Decimal?  @db.Decimal(18, 2)
  percentage  Decimal?  @db.Decimal(5, 2)
  maxAmount   Decimal?  @db.Decimal(18, 2)
  minDeposit  Decimal?  @db.Decimal(18, 2)
  wageringReq Decimal?  @db.Decimal(5, 2)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  usageLimit  Int?
  usageCount  Int       @default(0)
  createdAt   DateTime  @default(now())

  @@map("bonuses")
}

model Promotion {
  id          String   @id @default(cuid())
  title       String
  description String
  imageUrl    String?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  gameId      String?
  bonusId     String?
  createdAt   DateTime @default(now())

  @@map("promotions")
}

model AffiliateAccount {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  affiliateCode  String   @unique
  commissionRate Decimal  @default(10) @db.Decimal(5, 2)
  totalEarned    Decimal  @default(0) @db.Decimal(18, 2)
  totalPaid      Decimal  @default(0) @db.Decimal(18, 2)
  pendingAmount  Decimal  @default(0) @db.Decimal(18, 2)
  totalClicks    Int      @default(0)
  totalSignups   Int      @default(0)
  totalDeposits  Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  commissions AffiliateCommission[]

  @@map("affiliate_accounts")
}

model AffiliateCommission {
  id             String           @id @default(cuid())
  affiliateId    String
  affiliate      AffiliateAccount @relation(fields: [affiliateId], references: [id])
  referredUserId String
  type           String // SIGNUP, DEPOSIT, TICKET
  amount         Decimal          @db.Decimal(18, 2)
  isPaid         Boolean          @default(false)
  paidAt         DateTime?
  createdAt      DateTime         @default(now())

  @@map("affiliate_commissions")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType @default(IN_APP)
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime         @default(now())

  @@map("notifications")
}

model NotificationPreference {
  id              String  @id @default(cuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id])
  emailDeposit    Boolean @default(true)
  emailWithdrawal Boolean @default(true)
  emailTicket     Boolean @default(true)
  emailDraw       Boolean @default(true)
  emailWinning    Boolean @default(true)
  emailPromo      Boolean @default(false)
  inAppDeposit    Boolean @default(true)
  inAppWithdrawal Boolean @default(true)
  inAppTicket     Boolean @default(true)
  inAppDraw       Boolean @default(true)
  inAppWinning    Boolean @default(true)
  inAppPromo      Boolean @default(true)

  @@map("notification_preferences")
}

model SupportTicket {
  id                String               @id @default(cuid())
  userId            String?
  user              User?                @relation(fields: [userId], references: [id])
  ticketNumber      String               @unique @default(cuid())
  subject           String
  description       String?
  categoryId        String?
  category          TicketCategoryModel? @relation(fields: [categoryId], references: [id])
  status            SupportTicketStatus  @default(OPEN)
  priority          TicketPriority       @default(MEDIUM)
  departmentId      String?
  department        SupportDepartment?   @relation(fields: [departmentId], references: [id])
  assignedToId      String?
  assignedTo        SupportAgent?        @relation(fields: [assignedToId], references: [id])
  firstResponseTime DateTime?
  resolvedAt        DateTime?
  closedAt          DateTime?
  slaDeadline       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  messages      SupportMessage[]
  attachments   TicketAttachment[]
  assignments   TicketAssignment[]
  statusHistory TicketStatusHistory[]
  tags          TicketTag[]           @relation("TicketToTag")

  @@map("support_tickets")
}

model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id])
  senderId   String // Can be UserId or AgentId
  senderType String        @default("USER") // "USER" or "AGENT"
  message    String
  isInternal Boolean       @default(false)
  readAt     DateTime?
  createdAt  DateTime      @default(now())

  attachments TicketAttachment[]

  @@map("support_messages")
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("faqs")
}

model Banner {
  id              String    @id @default(cuid())
  title           String
  description     String?
  imageUrl        String
  mobileUrl       String?
  linkUrl         String?
  backgroundColor String?
  position        String    @default("HOME")
  isActive        Boolean   @default(true)
  startDate       DateTime?
  endDate         DateTime?
  sortOrder       Int       @default(0)
  metadata        Json?
  createdAt       DateTime  @default(now())

  @@map("banners")
}

model CmsPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String
  metaTitle String?
  metaDesc  String?
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("cms_pages")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String   @default("GENERAL")
  label     String?
  isPublic  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model PaymentMethod {
  id          String         @id @default(cuid())
  gateway     PaymentGateway
  name        String
  description String?
  isActive    Boolean        @default(true)
  config      Json
  minAmount   Decimal        @db.Decimal(18, 2)
  maxAmount   Decimal        @db.Decimal(18, 2)
  fees        Decimal        @default(0) @db.Decimal(5, 2)
  createdAt   DateTime       @default(now())

  @@map("payment_methods")
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  key         String    @unique
  permissions Json
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@map("api_keys")
}



// ============ SUPPORT CENTER ENUMS ============
enum SupportAgentStatus {
  ONLINE
  OFFLINE
  BUSY
  AWAY
  ON_BREAK
}

enum SupportAgentRole {
  SUPPORT_AGENT
  SENIOR_AGENT
  TEAM_LEAD
  SUPPORT_MANAGER
  COMPLIANCE_OFFICER
  SUPER_ADMIN
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
  CRITICAL
}

enum AttachmentType {
  IMAGE
  PDF
  VIDEO
  DOCUMENT
}

// ============ SUPPORT CENTER MODELS ============

model SupportAgent {
  id           String             @id @default(cuid())
  userId       String             @unique
  user         User               @relation(fields: [userId], references: [id])
  employeeId   String             @unique
  departmentId String?
  department   SupportDepartment? @relation(fields: [departmentId], references: [id])
  team         String?
  designation  String?
  role         SupportAgentRole   @default(SUPPORT_AGENT)
  status       SupportAgentStatus @default(OFFLINE)
  workingHours Json?
  timeZone     String             @default("UTC")
  languages    String[]
  skills       String[]
  experience   String?
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  assignedTickets SupportTicket[]
  activityLogs    AgentActivity[]
  performance     AgentPerformance?
  assignments     TicketAssignment[]

  @@map("support_agents")
}

model SupportDepartment {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agents  SupportAgent[]
  tickets SupportTicket[]

  @@map("support_departments")
}

model SystemSetting {
  id        String   @id @default(cuid())
  category  String   @unique
  data      Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("system_settings")
}

// ============ RBAC MODELS ============

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  department  String?
  priority    Int      @default(0)
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  permissions   RolePermission[]
  users         UserRoleMapping[]
  history       RoleHistory[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleMapping {
  id        String    @id @default(cuid())
  userId    String
  roleId    String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  grantedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RoleHistory {
  id        String   @id @default(cuid())
  roleId    String
  action    String
  changes   Json
  changedBy String
  createdAt DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@map("role_history")
}

model TicketAttachment {
  id        String          @id @default(cuid())
  ticketId  String?
  ticket    SupportTicket?  @relation(fields: [ticketId], references: [id])
  messageId String?
  message   SupportMessage? @relation(fields: [messageId], references: [id])
  fileName  String
  fileUrl   String
  fileType  AttachmentType
  fileSize  Int
  createdAt DateTime        @default(now())

  @@map("ticket_attachments")
}

model TicketTag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  tickets SupportTicket[] @relation("TicketToTag")

  @@map("ticket_tags")
}

model TicketCategoryModel {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  tickets SupportTicket[]

  @@map("ticket_categories")
}

model TicketAssignment {
  id           String        @id @default(cuid())
  ticketId     String
  ticket       SupportTicket @relation(fields: [ticketId], references: [id])
  agentId      String
  agent        SupportAgent  @relation(fields: [agentId], references: [id])
  assignedBy   String?
  assignedAt   DateTime      @default(now())
  unassignedAt DateTime?

  @@map("ticket_assignments")
}

model TicketStatusHistory {
  id        String              @id @default(cuid())
  ticketId  String
  ticket    SupportTicket       @relation(fields: [ticketId], references: [id])
  status    SupportTicketStatus
  changedBy String?
  changedAt DateTime            @default(now())
  reason    String?

  @@map("ticket_status_history")
}

model AgentActivity {
  id        String       @id @default(cuid())
  agentId   String
  agent     SupportAgent @relation(fields: [agentId], references: [id])
  action    String
  details   Json?
  createdAt DateTime     @default(now())

  @@map("agent_activity")
}

model AgentPerformance {
  id                  String       @id @default(cuid())
  agentId             String       @unique
  agent               SupportAgent @relation(fields: [agentId], references: [id])
  ticketsAssigned     Int          @default(0)
  ticketsSolved       Int          @default(0)
  openTickets         Int          @default(0)
  pendingTickets      Int          @default(0)
  avgResponseTime     Int          @default(0) // in seconds
  avgResolutionTime   Int          @default(0) // in seconds
  csatScore           Decimal      @default(0) @db.Decimal(5, 2)
  rating              Decimal      @default(0) @db.Decimal(5, 2)
  escalatedTickets    Int          @default(0)
  firstResponseSlaMet Int          @default(0)
  updatedAt           DateTime     @updatedAt

  @@map("agent_performance")
}

model KnowledgeBaseCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles KnowledgeBaseArticle[]

  @@map("kb_categories")
}

model KnowledgeBaseArticle {
  id          String                @id @default(cuid())
  categoryId  String
  category    KnowledgeBaseCategory @relation(fields: [categoryId], references: [id])
  title       String
  content     String
  tags        String[]
  views       Int                   @default(0)
  isPublished Boolean               @default(false)
  authorId    String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@map("kb_articles")
}

model SLARule {
  id                String         @id @default(cuid())
  priority          TicketPriority
  firstResponseTime Int // in minutes
  resolutionTime    Int // in minutes
  escalationTime    Int // in minutes
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("sla_rules")
}

// ============ JACKPOT ROLLOVER SYSTEM ============

enum JackpotTxType {
  CONTRIBUTION
  JACKPOT_WIN
  JACKPOT_RESET
  JACKPOT_ROLLOVER
  MANUAL_ADJUSTMENT
}

/// One row per game — live jackpot pool state
model JackpotPool {
  id                    String   @id @default(cuid())
  gameId                String   @unique
  game                  Game     @relation(fields: [gameId], references: [id])
  currentJackpot        Decimal  @default(0) @db.Decimal(18, 2)
  baseJackpot           Decimal  @default(1000000) @db.Decimal(18, 2)
  rolloverAmount        Decimal  @default(0) @db.Decimal(18, 2)
  currentDrawContrib    Decimal  @default(0) @db.Decimal(18, 2)
  consecutiveRollovers  Int      @default(0)
  totalPaid             Decimal  @default(0) @db.Decimal(18, 2)
  largestJackpot        Decimal  @default(0) @db.Decimal(18, 2)
  lastWinningDrawId     String?
  jackpotContribPct     Decimal  @default(60) @db.Decimal(5, 2)
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())

  history      JackpotHistory[]
  transactions JackpotTransaction[]

  @@map("jackpot_pools")
}

/// One row per completed draw — historical breakdown
model JackpotHistory {
  id               String      @id @default(cuid())
  jackpotPoolId    String
  jackpotPool      JackpotPool @relation(fields: [jackpotPoolId], references: [id])
  gameId           String
  drawId           String
  drawNumber       Int
  jackpotBefore    Decimal     @db.Decimal(18, 2)
  ticketContrib    Decimal     @db.Decimal(18, 2)
  rolloverAmount   Decimal     @db.Decimal(18, 2)
  winnerCount      Int         @default(0)
  jackpotPaid      Decimal     @default(0) @db.Decimal(18, 2)
  jackpotAfter     Decimal     @db.Decimal(18, 2)
  winnerUserIds    Json        @default("[]")
  createdAt        DateTime    @default(now())

  @@index([gameId])
  @@index([drawId])
  @@map("jackpot_history")
}

/// Financial audit log — every coin movement in the jackpot pool
model JackpotTransaction {
  id            String        @id @default(cuid())
  jackpotPoolId String
  jackpotPool   JackpotPool   @relation(fields: [jackpotPoolId], references: [id])
  gameId        String
  drawId        String?
  type          JackpotTxType
  amount        Decimal       @db.Decimal(18, 2)
  balanceBefore Decimal       @db.Decimal(18, 2)
  balanceAfter  Decimal       @db.Decimal(18, 2)
  description   String?
  metadata      Json?
  createdAt     DateTime      @default(now())

  @@index([gameId])
  @@index([type])
  @@map("jackpot_transactions")
}

